{
  "name": "docs-of-the-docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./.build/server/index.js",
    "deploy": "pnpm build && wrangler deploy",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "@the-docs/preset-default": "workspace:*",
    "isbot": "^5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6",
    "vite": "^8",
    "wrangler": "^4.121.0"
  }
}
