{
  "name": "@the-docs/core",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit false --declaration --declarationMap --sourceMap --outDir dist --rootDir src --allowImportingTsExtensions false && node ../../scripts/copy-package-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/rollup": "^3.1.1",
    "@the-docs/ui": "workspace:^",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.6",
    "react-router": "7.15.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^6"
  },
  "exports": {
    ".": "./dist/index.js",
    "./build": "./dist/build/index.js",
    "./route": "./dist/route/docs-post.js"
  },
  "description": "The Docs core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thspacecode/the-docs.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
