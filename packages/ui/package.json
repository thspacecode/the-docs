{
  "name": "@the-docs/ui",
  "version": "0.0.1-alpha.7",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit false --declaration --declarationMap --sourceMap --outDir dist --rootDir src --allowImportingTsExtensions false && mkdir -p dist/styles && cp src/styles/globals.css dist/styles/globals.css && node ../../scripts/copy-package-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@radix-ui/colors": "^3.0.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "exports": {
    "./globals.css": "./dist/styles/globals.css",
    "./lib/*": "./dist/lib/*.js",
    "./components/*": "./dist/components/*.js",
    "./hooks/*": "./dist/hooks/*.js"
  },
  "description": "The Docs ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thspacecode/the-docs.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
