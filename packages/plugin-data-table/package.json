{
  "name": "@the-docs/plugin-data-table",
  "version": "0.0.1-alpha.5",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit false --declaration --declarationMap --sourceMap --outDir dist --rootDir src --allowImportingTsExtensions false && node ../../scripts/copy-package-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@the-docs/plugin-contract": "workspace:^",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "typescript": "^6"
  },
  "exports": {
    ".": "./dist/index.js",
    "./build": "./dist/build/index.js",
    "./model": "./dist/model.js",
    "./runtime": "./dist/runtime/data-table.js"
  },
  "description": "The Docs plugin data table",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thspacecode/the-docs.git",
    "directory": "packages/plugin-data-table"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
