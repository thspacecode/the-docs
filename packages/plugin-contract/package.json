{
  "name": "@the-docs/plugin-contract",
  "version": "0.0.1-alpha.5",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit false --declaration --declarationMap --sourceMap --outDir dist --rootDir src --allowImportingTsExtensions false && node ../../scripts/copy-package-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.2.6",
    "typescript": "^6"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "description": "The Docs plugin contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thspacecode/the-docs.git",
    "directory": "packages/plugin-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
