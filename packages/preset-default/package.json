{
  "name": "@the-docs/preset-default",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit false --declaration --declarationMap --sourceMap --outDir dist --rootDir src --allowImportingTsExtensions false && node ../../scripts/copy-package-assets.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4",
    "@the-docs/core": "workspace:^",
    "@the-docs/plugin-bpmn": "workspace:^",
    "@the-docs/plugin-data-table": "workspace:^",
    "@the-docs/plugin-excalidraw": "workspace:^",
    "@the-docs/plugin-mermaid": "workspace:^",
    "@the-docs/plugin-syntax-highlighter": "workspace:^",
    "@the-docs/ui": "workspace:^",
    "react": "^19.2.6",
    "react-router": "7.15.1",
    "vite": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^6"
  },
  "exports": {
    ".": "./dist/index.js",
    "./react-router": "./dist/react-router.js",
    "./root": "./dist/root.js",
    "./routes": "./dist/routes.js",
    "./vite": "./dist/vite.js"
  },
  "description": "The Docs preset default",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thspacecode/the-docs.git",
    "directory": "packages/preset-default"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
