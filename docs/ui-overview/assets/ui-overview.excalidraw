      "boundElements": [],
      "updated": 1786364855185,
      "link": null,
      "locked": false,
      "text": "In Frappe workflows, the last eligible transition wins. Learn why transition\norder matters and how to fix unexpected state jumps.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
