      "type": "text",
      "x": -982.1562188693833,
      "y": 321.02886766085635,
      "width": 578.5292358398438,
      "height": 40,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#e9ecef",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
